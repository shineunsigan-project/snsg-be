SPRING_PROFILES_ACTIVE=prod

DB_URL=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

FRONTEND_REDIRECT_URI=
# local 프로파일(디스크 저장) 전용. dev·prod는 S3를 쓴다.
FILE_STORAGE_DIRECTORY=/data/files
# 프로필 사진 S3 버킷 이름(ap-northeast-2). 비어 있으면 dev·prod 기동이 실패한다. 자격 증명은 ECS task role로 받는다.
FILE_STORAGE_S3_BUCKET=
# 프로필 사진 CloudFront 주소(예 https://dxxxx.cloudfront.net, 끝 슬래시 없음). 비어 있으면 dev·prod 기동이 실패한다.
FILE_STORAGE_CLOUDFRONT_URL=
CORS_ALLOWED_ORIGINS=
JWT_SECRET=
DATA_GO_KR_API_KEY=
# JWT_SECRET과 다른 값이어야 한다(같으면 사용자·어드민 토큰 분리가 깨진다). HS256에 맞게 32바이트 이상.
ADMIN_JWT_SECRET=
# 어드민 앱 출처(쉼표로 여럿). 사용자 앱 출처를 넣지 않는다. 비우면 어드민 API를 브라우저에서 부를 수 없다.
ADMIN_CORS_ALLOWED_ORIGINS=
